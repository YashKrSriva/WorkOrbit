# ========================================================
# WorkOrbit — Environment Configuration
# ========================================================

# AI Studio Applet Configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT=3000

# Python FastAPI & SQLite / PostgreSQL Configuration
DATABASE_URL="sqlite:///./workorbit.db"
# Example PostgreSQL for production migration:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/workorbit"

# Authentication & Security
SECRET_KEY="replace_with_super_secret_cryptographic_key_32_bytes_min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP / Email Service (Optional for transactional invite delivery)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM="no-reply@workorbit.io"
